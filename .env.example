# Claude API (via OpenRouter)
OPENROUTER_API_KEY=

# Shopify Dev Store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# n8n (optional webhook triggers)
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Database (PostgreSQL in Docker)
POSTGRES_USER=shopiflow
POSTGRES_PASSWORD=shopiflow123
POSTGRES_DB=shopiflow

# n8n config
N8N_ENCRYPTION_KEY=change-me-in-production
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-in-production
