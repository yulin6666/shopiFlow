# ============================================
# ShopiFow — 环境变量模板
# 本地: cp .env.example .env，然后填入真实值
# Railway: 在服务的 Variables 面板中配置
#
# 必填: OPENROUTER_API_KEY
# 选填: 其余变量不填时自动使用 mock / demo 数据
# 注意: PINECONE_API_KEY 在 n8n credentials 里配置，不在这里
# ============================================

# ---- OpenRouter（必填）----
# 获取: https://openrouter.ai/keys → Create key
OPENROUTER_API_KEY=

# ---- Shopify Admin API（选填）----
# 不填则 Dashboard 显示 mock 订单数据
# 获取: Shopify Admin → Settings → Apps → Develop apps → 创建 Custom App
# 所需 scope: read_orders, read_products
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ---- Judge.me（选填，评论数据）----
# 不填则评论页显示 mock 数据
# 获取: Shopify 安装 Judge.me App → 后台 Settings → General → API token
JUDGE_ME_API_TOKEN=
JUDGE_ME_SHOP_DOMAIN=

# ---- Gorgias（选填，真实客服工单）----
# 不填则客服页只显示 Demo Chat 模式
# 获取: Gorgias 后台 → Settings → REST API → Create API key
# Base URL 格式: https://你的子域名.gorgias.com/api
GORGIAS_BASE_URL=
GORGIAS_EMAIL=
GORGIAS_API_KEY=

# ---- n8n Webhook（选填）----
# 不填则 AI 接口直接调用 OpenRouter（跳过 n8n）
# 本地: http://localhost:5678
# Railway: https://your-n8n.up.railway.app
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# ---- 数据库（选填）----
# 仅 n8n 工作流写日志用，不影响前端功能
# 本地用 n8n starter kit 的 PostgreSQL（外部端口 5433）
# Railway: 自动注入，无需手动填
DATABASE_URL=postgresql://root:password@localhost:5433/shopiflow_db

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_N8N_WEBHOOK_BASE_URL=http://localhost:5678
