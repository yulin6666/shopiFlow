{
  "name": "ShopiFow - Review Reply Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopiflow-review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-r-001",
      "name": "Webhook - New Review",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "shopiflow-review"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-001",
              "name": "reviewId",
              "value": "={{ $json.body.review_id }}",
              "type": "string"
            },
            {
              "id": "assign-002",
              "name": "customerName",
              "value": "={{ $json.body.customer_name }}",
              "type": "string"
            },
            {
              "id": "assign-003",
              "name": "productName",
              "value": "={{ $json.body.product_name }}",
              "type": "string"
            },
            {
              "id": "assign-004",
              "name": "rating",
              "value": "={{ $json.body.rating }}",
              "type": "number"
            },
            {
              "id": "assign-005",
              "name": "platform",
              "value": "={{ $json.body.platform }}",
              "type": "string"
            },
            {
              "id": "assign-006",
              "name": "reviewText",
              "value": "={{ $json.body.review_text }}",
              "type": "string"
            },
            {
              "id": "assign-007",
              "name": "sentiment",
              "value": "={{ $json.body.rating >= 4 ? 'positive' : $json.body.rating === 3 ? 'neutral' : 'negative' }}",
              "type": "string"
            },
            {
              "id": "assign-008",
              "name": "isHighPriority",
              "value": "={{ $json.body.rating <= 2 }}",
              "type": "boolean"
            },
            {
              "id": "assign-009",
              "name": "chatInput",
              "value": "={{ 'Customer: ' + $json.body.customer_name + '\\nProduct: ' + $json.body.product_name + '\\nPlatform: ' + $json.body.platform + '\\nRating: ' + $json.body.rating + '/5\\nSentiment: ' + ($json.body.rating >= 4 ? 'positive' : $json.body.rating === 3 ? 'neutral' : 'negative') + ($json.body.rating <= 2 ? '\\nPriority: HIGH — needs careful, solution-focused response' : '') + '\\n\\nReview:\\n\"' + $json.body.review_text + '\"' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-r-002",
      "name": "Prepare Review Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are a brand voice specialist for ShopiFow, an online fashion brand known for quality and customer care.\n\nYour job is to generate authentic, brand-consistent replies to customer reviews.\n\nGuidelines:\n- For 5-star reviews: be warm and grateful, mention something specific from their review\n- For 4-star reviews: thank them and address their suggestion constructively\n- For 3-star reviews: acknowledge their concern, apologize for shortcomings, offer concrete improvements\n- For 1-2 star reviews: lead with a sincere apology, take responsibility, offer a specific resolution (replacement/refund), do NOT be defensive\n- Always stay positive and solution-focused\n- Keep replies to 2-4 sentences\n- Sign off as \"— The ShopiFow Team\""
        }
      },
      "id": "node-r-003",
      "name": "Review AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [680, 300]
    },
    {
      "parameters": {
        "model": "anthropic/claude-sonnet-4-6",
        "options": {}
      },
      "id": "node-r-004",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [560, 520],
      "credentials": {
        "openAiApi": {
          "name": "OpenRouter"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $('Prepare Review Data').item.json.isHighPriority }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-r-005",
      "name": "High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, reply: $json.output, isHighPriority: true, alert: 'High-priority review — immediate attention needed' }) }}"
      },
      "id": "node-r-006",
      "name": "Respond - High Priority",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, reply: $json.output, isHighPriority: false }) }}"
      },
      "id": "node-r-007",
      "name": "Respond - Normal",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Webhook - New Review": {
      "main": [[{ "node": "Prepare Review Data", "type": "main", "index": 0 }]]
    },
    "Prepare Review Data": {
      "main": [[{ "node": "Review AI Agent", "type": "main", "index": 0 }]]
    },
    "Review AI Agent": {
      "main": [[{ "node": "High Priority?", "type": "main", "index": 0 }]]
    },
    "High Priority?": {
      "main": [
        [{ "node": "Respond - High Priority", "type": "main", "index": 0 }],
        [{ "node": "Respond - Normal", "type": "main", "index": 0 }]
      ]
    },
    "OpenRouter Chat Model": {
      "ai_languageModel": [[{ "node": "Review AI Agent", "type": "ai_languageModel", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["shopiflow", "reviews", "ai"],
  "triggerCount": 0,
  "updatedAt": "2026-08-03T00:00:00.000Z",
  "versionId": "shopiflow-review-v2"
}
