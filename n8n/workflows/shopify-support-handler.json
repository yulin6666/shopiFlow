    {
      "parameters": {
        "jsCode": "const agentOutput = $input.first().json.output || $input.first().json.text || '{}';\nlet parsed;\ntry {\n  // 先去掉 markdown code fence，再把未转义的实际换行符转义（reply 字段里常见）\n  const cleaned = agentOutput\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```\\s*$/i, '')\n    .trim();\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  const jsonStr = match ? match[0] : cleaned;\n  // 把 JSON 字符串值中的实际换行符转义，避免 parse 失败\n  const safeStr = jsonStr.replace(/(\"(?:[^\"\\\\]|\\\\.)*\")|(\\n)/g, (m, quoted, newline) => {\n    if (quoted) return quoted; // 保留字符串内的已转义内容\n    return '\\\\n';             // 字符串外的裸换行忽略（通常不存在）\n  });\n  // 更稳健：先尝试直接 parse，失败再用 replace 清理后重试\n  try {\n    parsed = JSON.parse(jsonStr);\n  } catch {\n    // 把字符串值内的裸换行和 tab 转义\n    const fixed = jsonStr.replace(/\"((?:[^\"\\\\]|\\\\.)*)\"/g, (m, inner) => {\n      return '\"' + inner.replace(/\\n/g, '\\\\n').replace(/\\r/g, '\\\\r').replace(/\\t/g, '\\\\t') + '\"';\n    });\n    parsed = JSON.parse(fixed);\n  }\n} catch (parseError) {\n  // 最后尝试：用正则从原始输出中提取 classification 字段值\n  const classMatch = agentOutput.match(/\"classification\"\\s*:\\s*\"(auto|draft|escalate)\"/i);\n  const replyMatch = agentOutput.match(/\"reply\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\n  const reasonMatch = agentOutput.match(/\"reason\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/);\n  const riskMatch = agentOutput.match(/\"risk_level\"\\s*:\\s*\"(low|medium|high)\"/i);\n  if (classMatch) {\n    parsed = {\n      classification: classMatch[1],\n      reason: reasonMatch ? reasonMatch[1] : 'Extracted from malformed JSON',\n      risk_level: riskMatch ? riskMatch[1] : 'medium',\n      reply: replyMatch ? replyMatch[1] : null\n    };\n  } else {\n    parsed = { classification: 'escalate', reason: 'AI output parse error', risk_level: 'high', reply: null };\n  }\n}\n\nconst ticket = $('Parse Input').first().json;\nconst classification = parsed.classification || 'escalate';\n\nif (!['auto', 'draft', 'escalate'].includes(classification)) {\n  parsed.classification = 'escalate';\n  parsed.reason = 'Invalid classification: ' + classification;\n}\n\nlet status;\nif (classification === 'auto') status = 'auto_replied';\nelse if (classification === 'draft') status = 'needs_review';\nelse status = 'escalated';\n\nconst aiCallTimeMs = Date.now() - ticket.startTime;\n\nreturn [{\n  json: {\n    aiCallTimeMs,\n    status,\n    classification: parsed.classification,\n    reason: parsed.reason || '',\n    riskLevel: parsed.risk_level || 'high',\n    reply: parsed.reply || null,\n    ticketId: ticket.ticketId,\n    customerName: ticket.customerName,\n    customerEmail: ticket.customerEmail,\n    platform: ticket.platform,\n    originalMessage: ticket.chatInput\n  }\n}];"
      },
      "id": "merge-result",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Parse Input').first().json;\nconst error = $input.first().json.error || {};\n\n// 降级兜底逻辑：AI 失败时标记为 draft（需人工审核）而非 escalate\n// 这是更安全的选择，避免误判为高风险\nconst aiCallTimeMs = Date.now() - ticket.startTime;\n\n// Capture n8n execution context\nconst executionId = $execution.id;\nconst workflowId = $workflow.id;\nconst workflowName = $workflow.name;\nconst failedNode = error.node?.name || 'AI Agent';\n\nreturn [{\n  json: {\n    aiCallTimeMs,\n    status: 'needs_review',\n    classification: 'draft',\n    reason: 'AI 分类服务暂时不可用，已标记为待审核: ' + (error.message || 'Unknown error'),\n    riskLevel: 'medium',\n    reply: '感谢您的消息。我们的团队会尽快为您处理。',\n    ticketId: ticket.ticketId,\n    customerName: ticket.customerName,\n    customerEmail: ticket.customerEmail,\n    platform: ticket.platform,\n    originalMessage: ticket.chatInput,\n    errorDetails: JSON.stringify(error),\n    fallbackApplied: true,\n    n8nExecutionId: executionId,\n    n8nWorkflowId: workflowId,\n    n8nWorkflowName: workflowName,\n    failedNode: failedNode\n  }\n}];"
      },
